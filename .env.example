# Copy to .env and replace with a randomly generated secret (32+ UTF-8 bytes).
WALLET_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
POSTGRES_PASSWORD=wallet-local-only
WALLET_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional admin account bootstrap. Set both values or leave both empty.
WALLET_ADMIN_EMAIL=
WALLET_ADMIN_PASSWORD=
